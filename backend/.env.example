# Conexión a la base de datos (local: apunta a localhost, Docker: apunta a portfolio-db)
DATABASE_URL=postgresql://portfolio_user:portfolio_pass@localhost:5432/portfolio_db

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# App
APP_PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Cloudflare R2
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key
R2_BUCKET_NAME=tu-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
